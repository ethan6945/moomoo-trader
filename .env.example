# ===== MooMoo OpenD =====
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PWD=your_6_digit_trade_password
MOOMOO_TRADE_ENV=SIMULATE        # SIMULATE = paper trading, REAL = live money
MOOMOO_MARKET=US                 # US / HK / CN / SG
MOOMOO_SECURITY_FIRM=FUTUMY      # FUTUMY (Malaysia) / FUTUINC (US) / FUTUSG / FUTUSECURITIES (HK) / FUTUAU / FUTUCA / FUTUJP

# ===== Gemini AI (signal validator) =====
GEMINI_API_KEYS=key1,key2        # comma-separated, rotated per call
GEMINI_MODEL=gemini-2.5-flash

# ===== Tavily (news context for Gemini) =====
TAVILY_API_KEY=                  # https://app.tavily.com — free tier 1000/mo

# ===== Telegram (signal + status notifications) =====
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Risk Settings =====
ACCOUNT_USD=4500                 # YOUR BUDGET — bot will never invest above this
RISK_PER_TRADE=0.02              # 2% per trade (auto-tuned by adaptive_sizing)
MAX_POSITIONS=10                 # 10 concurrent positions
MAX_POSITION_PCT=0.10            # 10% per stock cap (10 × 10% = 100% account)
DAILY_DRAWDOWN_STOP=0.03         # halt trading if -3% intraday

# ===== Drawdown Circuit Breaker =====
DD_SIZE_CUT_PCT=10.0             # halve qty when account DD ≥ 10%
DD_HALT_PCT=15.0                 # halt new entries when DD ≥ 15%

# ===== Scoring & Timeframe (Optuna-tuned 180d) =====
ENTRY_SCORE_THRESHOLD=60         # 0-100, only enter if score ≥
SCAN_INTERVAL_MIN=30             # scan every N minutes
MAX_HOLD_DAYS=5                  # force-close positions older than N days
TIMEFRAME=HOUR_1                 # HOUR_1 (live frame). DAILY trading mode removed 2026-06-07 (HOUR_1 won backtests).

# ===== Exit & Gap Knobs (Optuna-tuned) =====
TP_ATR_MULT=3.0                  # take-profit = entry + 3.0 × ATR
SL_ATR_MULT=3.25                 # stop-loss   = entry - 3.25 × ATR
MAX_GAP_PCT=2.5                  # block entry if overnight gap > 2.5%

# ===== Regime Up-Scaling (tailwind press) =====
# Boost position size ONLY in a confirmed strong bull (SPY>50>200MA) AND calm
# VIX (< REGIME_VIX_CALM). 1.0 = off (no change). 1.4 = conservative boost
# (140d/$5k backtest: a few % more $/day, drawdown flat). Higher multipliers
# (2×+) were over-fit noise on ~40 trades — don't chase them. Mirrored by the
# honest backtest engine so live ↔ backtest stay in parity. Still obeys the
# per-stock cap (MAX_POSITION_PCT), so it can't breach concentration limits.
REGIME_BULL_MULT=1.0
REGIME_VIX_CALM=20

# ===== DeepSeek Autonomous Optimizer (optional) =====
# When the key is set, the weekly self-review feeds REAL fills to DeepSeek, which
# proposes small param tweaks (entry threshold / tp / sl). EACH proposal is then
# backtested on the honest engine (180d + 360d) and only queued for YOUR approval
# if it beats baseline $/day WITHOUT worsening drawdown. It never auto-applies.
# Leave the key blank to disable (optimizer becomes a no-op). OpenAI-compatible.
DEEPSEEK_API_KEY=                # https://platform.deepseek.com — blank = optimizer off
DEEPSEEK_MODEL=deepseek-chat     # reasoning models also OK (need enough max_tokens)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# (ML alpha engine removed 2026-06-03 — proven inert on this universe, AUC ≈ 0.5.)
